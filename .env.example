REDIS_URL=redis://localhost:6379

# Timeline / ingest (see PYTHON_WORKERS_IMPLEMENTATION.md)
# Frontend MediaRecorder chunk size should match MEDIA_CHUNK_DURATION_MS (often 6000).
MEDIA_CHUNK_DURATION_MS=6000
ASR_CONTEXT_WINDOW_MS=10000
TEXT_ANALYSIS_INTERVAL_MS=30000
TARGET_SAMPLE_RATE=16000

# Hugging Face token (gated pyannote — batch/offline diarization)
HF_TOKEN=

# Whisper live ASR (workers/audio/asr.py) — needs NVIDIA + CUDA torch for medium at live pace
# Install GPU torch first: see requirements.txt header
WHISPER_MODEL_SIZE=medium
WHISPER_LANGUAGE=tr
# CPU-only dev machines: use WHISPER_MODEL_SIZE=small

# Batch runner overrides (optional)
# BATCH_WHISPER_MODEL_SIZE=medium
# BATCH_WHISPER_LANGUAGE=tr

# Live ingest feature flags (1 / true = on)
RUN_LIVE_VAD_ENERGY=1
RUN_LIVE_ASR=1
RUN_LIVE_DIARIZATION_STUB=1
RUN_LIVE_SPEAKER_ID=1

# VAD: quantile is legacy; live path uses absolute RMS below
VAD_ENERGY_RMS_QUANTILE=0.35
VAD_SPEECH_RMS_THRESHOLD=0.022
# Skip Whisper when window speech ratio is below this (percent)
VAD_SPEECH_RATIO_MIN_ASR=10.0

# Live ECAPA speaker identity (same timbre → same Speaker N across chunks)
SPEAKER_MIN_SEGMENT_MS=400
SPEAKER_NEW_IDENTITY_MIN_MS=700
# SPEAKER_MATCH_COS_THRESHOLD=0.25
# SPEAKER_MAX_CANONICAL=8

# Batch runner (offline) — python -m workers.audio.batch_runner
# BATCH_AUDIO_FILE=audio/meeting_clean.wav
# BATCH_RUN_VAD=1
# BATCH_RUN_DIARIZATION=0
# BATCH_RUN_TRANSCRIPTION=0
# BATCH_RUN_REFINEMENT=0
# BATCH_OUTPUT_DIR=outputs
