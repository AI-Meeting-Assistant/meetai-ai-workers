REDIS_URL=redis://localhost:6379

# Timeline / ingest (defaults 2000 / 10000 / 30000 — see PYTHON_WORKERS_IMPLEMENTATION.md)
MEDIA_CHUNK_DURATION_MS=2000
ASR_CONTEXT_WINDOW_MS=10000
TEXT_ANALYSIS_INTERVAL_MS=30000
TARGET_SAMPLE_RATE=16000

# Hugging Face (gated pyannote batch models)
HF_TOKEN=

# Whisper (live ingest path uses workers/audio/asr.py singleton)
WHISPER_MODEL_SIZE=small
WHISPER_LANGUAGE=tr
# Overrides for batch_runner only (default: WHISPER_MODEL_SIZE medium fallback in code paths)
# BATCH_WHISPER_MODEL_SIZE=medium
# BATCH_WHISPER_LANGUAGE=tr

# Live ingest feature flags (1/true = on)
RUN_LIVE_VAD_ENERGY=1
RUN_LIVE_ASR=1
RUN_LIVE_DIARIZATION_STUB=1
VAD_ENERGY_RMS_QUANTILE=0.35

# Batch runner (offline) — python -m workers.audio.batch_runner
# BATCH_AUDIO_FILE=audio/meeting_clean.wav
# BATCH_RUN_VAD=1
# BATCH_RUN_DIARIZATION=0
# BATCH_RUN_TRANSCRIPTION=0
# BATCH_RUN_REFINEMENT=0
# BATCH_OUTPUT_DIR=outputs
